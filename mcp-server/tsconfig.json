{
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
