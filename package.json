{
  "name": "chip-agent",
  "version": "0.1.0",
  "description": "Claude Code plugin: NL to simulation-verified Verilog",
  "bin": {
    "chip-agent": "./bin/install.js"
  },
  "files": [
    "bin/",
    "skills/",
    "agents/",
    "scripts/",
    "mcp-server/index.ts",
    "mcp-server/lib/",
    "mcp-server/tools/",
    "mcp-server/package.json",
    "mcp-server/package-lock.json",
    "mcp-server-python/server.py",
    "mcp-server-python/requirements.txt",
    "mcp-server-docker-python/server.py",
    "mcp-server-docker-python/casebook.py",
    "mcp-server-docker-python/orfs_metrics.py",
    "mcp-server-docker-python/requirements.txt",
    "chisel-project/build.sbt",
    "chisel-project/project/build.properties",
    "chisel-project/project/plugins.sbt",
    "chisel-project/src/",
    "templates/",
    ".claude-plugin/"
  ],
  "keywords": [
    "claude-code",
    "plugin",
    "chisel",
    "verilog",
    "hardware"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:backend": "npm --prefix mcp-server test",
